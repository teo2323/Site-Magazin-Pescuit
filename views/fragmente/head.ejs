<script>
    (function() {
        // Aplicare imediată pentru a preveni FOUC
        const temaSalvata = localStorage.getItem('tema_aleasa') || 'light';
        if (temaSalvata !== 'light') {
            document.documentElement.classList.add(temaSalvata);
            if (temaSalvata === 'dark-theme') document.documentElement.setAttribute('data-bs-theme', 'dark');
            if (document.body) document.body.classList.add(temaSalvata);
        }
    })();
</script>
