
<header>
    <h1>Magazinul Teo Pescarul</h1>
    <div style="display: flex; align-items: center; gap: 50px; flex-wrap: wrap;">
        <figure style="margin: 0;">
            <picture>
                <source media="(min-width: 1024px)" srcset="/resurse/imagini/stiuca100.png">
                <source media="(min-width: 768px)" srcset="/resurse/imagini/stiuca-medie.png">
                <img src="/resurse/imagini/stiuca-mica.png" alt="Captura stiuca Teo Pescarul" title="Stiuca la spinning" width="400">
            </picture>
            <figcaption>Captură impresionantă la spinning - Teo Pescarul.</figcaption>
        </figure>
        <div id="zoom-imagine-header">
            <p>Apasă pe imaginea de mai jos pentru a o vedea la dimensiunea completă:</p>
            <a href="/resurse/imagini/stiuca100.png">
                <img src="/resurse/imagini/stiuca100.png" alt="Stiuca miniatura" width="100">
            </a>
        </div>
    </div>

    <nav>
        <input type="checkbox" id="ch-menu">
        <label for="ch-menu" id="hamburger">
            <i class="fa-solid fa-bars"></i>
        </label>
        <ul class="menu">
            <li>
                <a href="/" id="home-link">
                    <span class="text-acasa">Acasă</span>
                    <i class="fa-solid fa-house icon-acasa"></i>
                </a>
            </li>
            <li>
                <div class="div-meniu">
                    <i class="fa-solid fa-store"></i>
                    <span class="text-item">Produse</span>
                </div>
                <ul>
                    <li><a href="/produse?tip=toate">toate</a></li>
                    <% if (locals.categorii) { %>
                        <% locals.categorii.forEach(function(categorie) { %>
                            <li><a href="/produse?tip=<%- categorie %>"><%- categorie %></a></li>
                        <% }); %>
                    <% } %>
                </ul>
            </li>
            <li>
                <div class="div-meniu">
                    <i class="fa-solid fa-compass"></i>
                    <span class="text-item">Navigare Pagina Acasă </span>
                </div>
                <ul>
                    <li><a href="#despre-noi">Despre Noi</a></li>
                    <li><a href="#evenimente">Evenimente</a></li>
                    <li><a href="#video-utile">Video</a></li>
                </ul>
            </li>
            <li>
                <a href="/inregistrare">
                    <i class="fa-solid fa-user-plus"></i>
                    <span class="text-item">Înregistrare</span>
                </a>
            </li>
            <li>
                <a href="/contact">
                    <i class="fa-solid fa-envelope"></i>
                    <span class="text-item">Contact</span>
                </a>
            </li>
            <li>
                <a href="/blog">
                    <i class="fa-solid fa-newspaper"></i>
                    <span class="text-item">Blog</span>
                </a>
            </li>
            <li class="d-flex align-items-center px-3" style="cursor: pointer;">
                <div class="form-check form-switch d-flex align-items-center m-0 p-0">
                    <label class="form-check-label me-2 mb-0" for="btn-schimba-tema">
                        <i id="icon-tema" class="fa-solid fa-sun" style="font-size: 1.2rem;"></i>
                    </label>
                    <input class="form-check-input m-0" type="checkbox" role="switch" id="btn-schimba-tema" style="cursor: pointer; transform: scale(1.2);">
                </div>
            </li>
        </ul>
    </nav>
</header>
